# JAVLibrary 爬虫配置文件

# ========== JAVBus 网站配置 ==========
# JAVBus 网站 URL
JAVBUS_URL=https://www.javbus.com/

# JAVBus 基础 URL（用于转换相对路径）
JAVBUS_BASE_URL=https://www.javbus.com

# ========== 代理配置 ==========
# 是否启用代理 (true/false)
PROXY_ENABLED=false

# 代理 URL（支持 HTTP、HTTPS、SOCKS5）
# 示例：
# HTTP 代理: http://127.0.0.1:7890
# HTTPS 代理: https://127.0.0.1:7890
# SOCKS5 代理: socks5://127.0.0.1:1080
PROXY=http://127.0.0.1:10808

# ========== Scrapling 会话配置 ==========
# 是否加载 DOM (true/false)
SCRAPLING_LOAD_DOM=true

# 是否等待网络空闲 (true/false)
SCRAPLING_NETWORK_IDLE=true

# 是否禁用资源加载 (true/false)
SCRAPLING_DISABLE_RESOURCES=true

# 是否启用无头模式 (true/false)
SCRAPLING_HEADLESS=true

# Scrapling 超时时间（毫秒）
SCRAPLING_TIMEOUT=30000

# ========== HTTP 请求配置 ==========
# User-Agent
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# 下载超时时间（秒）
DOWNLOAD_TIMEOUT=10

# 是否验证 SSL 证书 (true/false)
VERIFY_SSL=false

# ========== 本地影片库（gallery_server）==========
# 本地影片库根目录；扫描时只索引该目录下含视频文件的子目录
# 不设置则禁用本地库功能（无 /library 页面、磁力抓取不过滤）
LIBRARY_ROOT=Z:/JAV

# 索引文件输出路径（相对项目根目录）
LIBRARY_INDEX=Z:/JAV/library_index.json

# ========== 最想要列表导出（export_mostwanted.py）==========
# 最想要列表的「数据根目录」—— javlibrary_movies.json 与每部影片的
# <CARID> <title>/ 文件夹都放在这里（cover.jpg、sample_NNN.jpg 等）。
# 不设置时：javlibrary_movies.json 走默认 output/，本地库落地功能禁用。
MOSTWANTED_LIBRARY_ROOT=Z:/MostWanted
