# .env.example — JavlibraryScrapy 配置模板
# 复制为 .env 并填实际值。**不要把含真实凭据的 .env 提交到 git。**
# 现有 .env 已 commit（用户的实际路径），这个文件是给新部署的人参考用。

# ========== JAVBus 网站配置 ==========
JAVBUS_URL=https://www.javbus.com

# JAVLibrary「最想要」入口 URL（默认 c99i.com 镜像；换回 javlibrary.com 原站或
# 切其他镜像时改这里）。
JAVLIBRARY_URL=https://www.c99i.com/cn/vl_mostwanted.php

# ========== 代理配置 ==========
# PROXY=http://127.0.0.1:10808              # HTTP/HTTPS/SOCKS5 代理地址
# 代理按用途拆成两个开关：开关 + PROXY 都得有值才实际启用。
PROXY_JAVBUS_ENABLED=false                   # JAVBus 详情抓取 + 磁力抓取 + 封面代理
PROXY_JAVLIBRARY_ENABLED=false               # JAVLibrary 镜像抓取

# ========== Scrapling 会话配置 ==========
SCRAPLING_LOAD_DOM=true
SCRAPLING_NETWORK_IDLE=true
SCRAPLING_DISABLE_RESOURCES=true
SCRAPLING_HEADLESS=true
SCRAPLING_TIMEOUT=30000

# ========== HTTP 请求配置 ==========
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
DOWNLOAD_TIMEOUT=10
VERIFY_SSL=false

# ========== 本地影片库（gallery_server）==========
# LIBRARY_ROOT=Z:/JAV
# LIBRARY_INDEX=Z:/JAV/library_index.json

# ========== 最想要列表导出（export_mostwanted.py）==========
# MOSTWANTED_LIBRARY_ROOT=Z:/MostWanted

# 可选：单独指定 javlibrary_movies.json 路径，优先级高于 MOSTWANTED_LIBRARY_ROOT。
# 不设则 JSON 落在 MOSTWANTED_LIBRARY_ROOT/javlibrary_movies.json，否则 output/ 下。
# 此变量只控制 JSON 路径，不影响每部影片的 cover/samples 子目录（那些仍随 MOSTWANTED_LIBRARY_ROOT 走）。
# MOSTWANTED_INDEX=Z:/MostWanted/javlibrary_movies.json

# 可选：磁力抓取结果 JSON 路径（magnets_links.txt 与之同目录派生）。
# 不设则写到 output/magnets.json。
# MAGNETS_INDEX=Z:/JAV/Magnets/magnets.json

# ========== 极空间 NAS 集成（/api/zspace/*）==========
# 把 wanted 抓取得到的 magnet 推到极空间下载器。
# 前置：先在极空间后台「下载」app 启用下载服务（启用后 qbittorrent-nox/aria2c/xunlei 才会启动）。
# 所有字段都从 .env 读取，运行时只读（不再有 UI 编辑入口）；改完需重启服务。
#
# ZSPACE_ENABLED=true
# ZSPACE_HOST=192.168.1.100                # 内网 IP（API 端口固定 5055）
# ZSPACE_USER=138xxxxxxxx                  # 注册手机号
# ZSPACE_PASSWORD=xxxxxxxx                 # 登录密码（>=8 字符）
# ZSPACE_DEVICE_ID=                        # 32 字符 hex；首次启用会被要求短信验证，验证后从浏览器 cookie 复制填入，避免每次重验证
# ZSPACE_DOWNLOAD_PATH=/sata14/my/data/zvideo/JAV   # NAS 上的下载目录（/pool/my/data/.../），pool 名取决于你的存储池