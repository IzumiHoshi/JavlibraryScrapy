# 容器版配置：复制为 .env.docker 后按需修改。
# 与宿主机的 .env 分开维护 —— 容器里的路径必须是 **容器内路径**（/data/...），
# 不能是 Z:/ 这种 Windows 盘符。docker-compose.yml 负责把宿主目录挂到 /data 下。
#
# 优先级说明：代码里是 load_dotenv(override=False)，即环境变量优先于 .env 文件，
# 所以 compose 注入的这些值一定生效。

# ---------- 宿主机侧的挂载源（被 docker-compose.yml 的 ${...} 读取）----------
# Windows 上不要用映射盘（Z:），Docker Desktop 认不出；用 UNC 或本地路径。
# 例：LIBRARY_HOST_PATH=//nas/Private/JAV  或  D:/JAV
LIBRARY_HOST_PATH=D:/JAV
MOSTWANTED_HOST_PATH=D:/MostWanted
DOWNLOAD_HOST_PATH=D:/UnScraper

# ---------- 站点 ----------
JAVBUS_URL=https://www.javbus.com
JAVLIBRARY_URL=https://www.c99i.com/cn/vl_mostwanted.php

# ---------- 代理 ----------
# 宿主机上跑的本地代理，从容器里看不是 127.0.0.1，而是 host.docker.internal。
PROXY=http://host.docker.internal:10808
PROXY_JAVBUS_ENABLED=true
PROXY_JAVLIBRARY_ENABLED=false

# ---------- Scrapling ----------
SCRAPLING_LOAD_DOM=true
SCRAPLING_NETWORK_IDLE=true
SCRAPLING_DISABLE_RESOURCES=true
SCRAPLING_HEADLESS=true          # 容器里没有显示器，必须 true
SCRAPLING_TIMEOUT=30000

# ---------- HTTP ----------
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
DOWNLOAD_TIMEOUT=10
VERIFY_SSL=false

# ---------- 容器内数据路径（对应 compose 的挂载点）----------
LIBRARY_ROOT=/data/JAV
LIBRARY_INDEX=/app/output/library_index.json     # 库是 ro 挂载，索引写到 output 卷
MOSTWANTED_LIBRARY_ROOT=/data/MostWanted
MOSTWANTED_INDEX=/data/MostWanted/javlibrary_movies.json
MAGNETS_INDEX=/data/MostWanted/magnets.json
LOCAL_DOWNLOAD_PATH=/data/UnScraper

# ---------- 极空间 NAS ----------
ZSPACE_ENABLED=false
ZSPACE_HOST=192.168.0.47
ZSPACE_USER=
ZSPACE_PASSWORD=
ZSPACE_DEVICE_ID=
ZSPACE_DOWNLOAD_PATH=/sata11/public/我的地盘/Private/UnScraper
